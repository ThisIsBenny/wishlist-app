NODE_ENV=development
VITE_API_BASEURL=http://localhost:5000/api
DATABASE_URL="file:../data/data.db"

# JWT / Session (required)
JWT_SECRET=your-secure-random-secret-at-least-32-chars

# Email/Password Auth (enable/disable)
AUTH_EMAIL_LOGIN_ENABLED=true
AUTH_EMAIL_REGISTER_ENABLED=true

# OIDC Providers (optional, uncomment and configure as needed)
# OIDC_POCKETID_NAME=PocketID
# OIDC_POCKETID_CLIENT_ID=your-client-id
# OIDC_POCKETID_CLIENT_SECRET=your-client-secret
# OIDC_POCKETID_ISSUER_URL=https://pocketid.example.com

# Public base URL of the deployment (required for OIDC in production,
# used to build the provider redirect_uris). Leave empty in local dev.
# PUBLIC_URL=https://wishlist.example.com
